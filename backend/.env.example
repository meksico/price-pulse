# PricePulse Backend Environment Configuration (Copy to .env — never commit real secrets)

# Storage adapter: "local_json" (default air-gapped dev) | "google_sheets" (live workbook)
STORAGE_ADAPTER=local_json

# Scraper adapter: "deterministic" (offline dev/E2E) | "playwright" (live headless Chromium)
SCRAPER_ADAPTER=deterministic

# Auth mode: "local_dev" (127.0.0.1 bypass) | "google_oauth" (Bearer token verification)
AUTH_MODE=local_dev
ALLOWED_OWNER_EMAIL=

# Google Sheets & Gmail OAuth 2.0 credentials (required when STORAGE_ADAPTER=google_sheets)
SPREADSHEET_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional overrides
LOCAL_STATE_PATH=
FRONTEND_DIST_DIR=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
